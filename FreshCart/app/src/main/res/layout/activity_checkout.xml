<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/FreshCart.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Delivery details"
                android:textSize="18sp" />

            <EditText
                android:id="@+id/et_name"
                style="@style/FreshCart.Field"
                android:hint="Full name"
                android:inputType="textPersonName" />

            <EditText
                android:id="@+id/et_phone"
                style="@style/FreshCart.Field"
                android:hint="Mobile number (10 digits)"
                android:inputType="phone"
                android:maxLength="10" />

            <EditText
                android:id="@+id/et_address"
                style="@style/FreshCart.Field"
                android:hint="Address (house, street, area)"
                android:inputType="textPostalAddress|textMultiLine"
                android:minLines="2" />

            <EditText
                android:id="@+id/et_pincode"
                style="@style/FreshCart.Field"
                android:hint="Pincode"
                android:inputType="number"
                android:maxLength="6" />

            <CheckBox
                android:id="@+id/cb_save_address"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Save this address for next time" />

            <EditText
                android:id="@+id/et_notes"
                style="@style/FreshCart.Field"
                android:hint="Delivery instructions (optional)"
                android:inputType="textMultiLine" />

            <TextView
                style="@style/FreshCart.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Delivery slot"
                android:textSize="18sp" />

            <RadioGroup
                android:id="@+id/rg_slot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/rb_slot_now"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Express (30 min) +₹25" />

                <RadioButton
                    android:id="@+id/rb_slot_evening"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Today 6 PM - 8 PM" />

                <RadioButton
                    android:id="@+id/rb_slot_tomorrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tomorrow 8 AM - 10 AM" />
            </RadioGroup>

            <TextView
                style="@style/FreshCart.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Tip your delivery partner"
                android:textSize="18sp" />

            <RadioGroup
                android:id="@+id/rg_tip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rb_tip_none"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="None" />

                <RadioButton
                    android:id="@+id/rb_tip_10"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹10" />

                <RadioButton
                    android:id="@+id/rb_tip_20"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹20" />

                <RadioButton
                    android:id="@+id/rb_tip_30"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹30" />
            </RadioGroup>

            <TextView
                style="@style/FreshCart.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Payment method"
                android:textSize="18sp" />

            <RadioGroup
                android:id="@+id/rg_payment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/rb_cod"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Cash on delivery" />

                <RadioButton
                    android:id="@+id/rb_upi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="UPI" />
            </RadioGroup>

            <EditText
                android:id="@+id/et_upi"
                style="@style/FreshCart.Field"
                android:hint="UPI ID (e.g. name@bank)"
                android:inputType="textEmailAddress"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/error"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_amount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:visibility="gone" />

    <Button
        android:id="@+id/btn_place_order"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:text="Place order" />
</LinearLayout>
